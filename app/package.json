{
  "name": "jco",
  "productName": "J.Co",
  "version": "0.4.9",
  "description": "J.Co · 自媒体管家（桌面版）",
  "author": "Jay",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "tsc -p tsconfig.json",
    "gate": "node scripts/gate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src tests scripts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "commit-and-tag-version": "^13.3.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "^0.2.0-rc.2",
    "playwright": "^1.64.1"
  }
}
