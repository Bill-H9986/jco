{
  "name": "jco",
  "productName": "J.Co",
  "version": "0.6.0-beta.4",
  "description": "J.Co · 自媒体管家（桌面版）",
  "author": "Jay",
  "main": "main.js",
  "private": true,
  "jco": {
    "updateFeedUrl": "",
    "updateCheckIntervalHours": 4
  },
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "gate": "node scripts/gate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src tests scripts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.mjs",
    "release:package": "node scripts/release-package.mjs",
    "update:serve": "node scripts/update-feed-server.mjs",
    "check:no-direct-business-localstorage": "node scripts/check-all.mjs --only no-direct-business-localstorage --baseline",
    "check:no-hardcoded-industry": "node scripts/check-all.mjs --only no-hardcoded-industry --baseline",
    "check:no-chat-browser-tools": "node scripts/check-all.mjs --only no-chat-browser-tools --baseline",
    "check:no-direct-tasks-dispatch": "node scripts/check-all.mjs --only no-direct-tasks-dispatch --baseline",
    "check:no-duplicate-sidebar": "node scripts/check-all.mjs --only no-duplicate-sidebar --baseline",
    "check:no-message-truncation": "node scripts/check-all.mjs --only no-message-truncation --baseline",
    "check:all-pages-migrated": "node scripts/check-all.mjs --only all-pages-migrated",
    "check:full-project-layers": "node scripts/check-all.mjs --only full-project-layers",
    "check:cross-page-journeys": "node scripts/check-all.mjs --only cross-page-journeys",
    "check:visual-regression-all": "node scripts/check-all.mjs --only visual-regression-all",
    "check:all": "node scripts/check-all.mjs --baseline",
    "security:gate": "node scripts/security-gate.mjs",
    "eval:agent": "npm run build && node scripts/run-agent-eval.mjs",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "commit-and-tag-version": "^13.3.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.0-rc.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "electron-updater": "6.8.9",
    "playwright": "^1.64.1"
  }
}
