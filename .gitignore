# 依赖（体积大，可随时重装）
app/node_modules/

# 构建与测试产物（可随时重生成，不进版本库）
app/dist/
app/release/
app/playwright-report/
app/test-results/
app/tests/report/

# 本地备份存档（体积大；其中也含运行时配置）
备份/
*.zip

# 运行时本地配置（含 API Key，绝不入库）
app/kernel/model-config.json
# 发布会话文件含本地 endpoint/token，绝不入库
app/kernel/publish-session.json
# 发布工具 patch（自动生成，含本机路径，不入库）
app/kernel/publish-tools.patch.yml
# 岗位系统提示词与按 profile 生成的工具 patch（运行时生成，含本机路径）
app/kernel/jco-persona-*.patch.yml
app/kernel/jco-publish-tools-*.patch.yml
app/kernel/jco-edit-tools-*.patch.yml
# 技能库同步副本（运行时生成、随界面走，不入库）
app/kernel/skills.json
# 自动任务表与执行记录（运行时生成：页面同步 / 调度器写，不入库）
app/kernel/auto-tasks.json
app/kernel/auto-runs.json
# 视觉守门员的改前副本（临时对比用，不入库）
设计原型/.verify-before-*

# 杂项
*.log
Thumbs.db
.DS_Store
# 任务会话台账（运行时生成：任务桥写入，不入库）
app/kernel/task-sessions/
# 后期工具配置与 patch（运行时生成：main/bridge 写入，不入库）
app/kernel/edit-tools.json
app/kernel/edit-tools.patch.yml
